generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String   @id @default(cuid())
  fullName    String
  headline    String
  shortBio    String
  longBio     String
  degree      String
  university  String
  careerGoals String
  interests   String[]
  avatarUrl   String?
  resumeUrl   String?
  email       String
  location    String?
  updatedAt   DateTime @updatedAt
}

model SocialLink {
  id           String @id @default(cuid())
  platform     String // "github" | "linkedin" | "email" | "kaggle" | "twitter"
  label        String
  url          String
  displayOrder Int    @default(0)
}

model Experience {
  id               String    @id @default(cuid())
  company          String
  role             String
  location         String?
  employmentType   String? // "Internship" | "Part-time" | "Full-time" | "Research"
  startDate        DateTime
  endDate          DateTime?
  description      String
  responsibilities String[]
  achievements     String[]
  technologies     String[]
  displayOrder     Int       @default(0)
}

model Education {
  id           String    @id @default(cuid())
  institution  String
  degree       String
  fieldOfStudy String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  gpa          String?
  modules      String[]
  coursework   String[]
  achievements String[]
  displayOrder Int       @default(0)
}

model Project {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  summary          String
  problemStatement String
  description      String
  technologies     String[]
  githubUrl        String?
  liveUrl          String?
  keyAchievements  String[]
  lessonsLearned   String[]
  featured         Boolean        @default(false)
  status           String         @default("completed") // completed | in_progress | archived
  startDate        DateTime?
  endDate          DateTime?
  displayOrder     Int            @default(0)
  images           ProjectImage[]
}

model ProjectImage {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  displayOrder Int     @default(0)
}

model Skill {
  id           String @id @default(cuid())
  name         String
  category     String // "programming" | "data_science" | "tools"
  proficiency  Int    @default(3) // 1-5
  iconSlug     String?
  displayOrder Int    @default(0)
}

model Certification {
  id            String    @id @default(cuid())
  title         String
  issuer        String
  category      String // "certification" | "hackathon" | "competition" | "leadership" | "course"
  dateEarned    DateTime?
  credentialUrl String?
  description   String?
  displayOrder  Int       @default(0)
}
